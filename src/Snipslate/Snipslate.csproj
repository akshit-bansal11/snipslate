<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Snipslate</AssemblyName>
    <RootNamespace>Snipslate</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Snipslate</Product>
    <Company>Akshit Bansal</Company>
    <Copyright>Copyright (c) 2026 Akshit Bansal</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snipslate.Tests" />
  </ItemGroup>

</Project>
